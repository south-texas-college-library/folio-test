{
  "displayName": "Collection - Inventory Search",
  "description": "Search inventory records using a combination of call number range, title, subject, material type, subtype, campus, and department filters. Results include items that match the selected criteria.",
  "instructions": "Enter any combination of search criteria to locate inventory items. Optional filters: \n\n\n• Call Number Range (Start/End)\n\n\n• Title and Search Type\n\n\n• Subjects (use OR between terms; use - to exclude a term)\n\n\n• Material Type\n\n\n• Subtype• Campus• Department\n\n\nLeave a field blank or select All to include all values for that filter.",
  "parameters": [
    {
      "name": "start_cn",
      "displayName": "Start Call Number",
      "type": "text",
      "required": false
    },
    {
      "name": "end_cn",
      "displayName": "End Call Number",
      "type": "text",
      "required": false
    },
    {
      "name": "subjects",
      "displayName": "Subjects",
      "type": "text",
      "required": false
    },
    {
      "name": "title",
      "displayName": "Title",
      "type": "text",
      "required": false
    },
    {
      "name": "search_type",
      "displayName": "Search Type",
      "type": "text",
      "required": false,
      "default": "Contains All",
      "controlled.options": [
        "Contains All",
        "Exact Match",
        "Contains Any",
        "Starts With",
        "Ends With"
      ]
    },
    {
      "name": "material_type",
      "displayName": "Material Type",
      "type": "text",
      "required": false,
      "default": "All",
      "controlled.options": [
        "All",
        "2HR-ITEM",
        "3HR-ITEM",
        "4HR-ITEM",
        "2DAY-ITEM",
        "3DAY-ITEM",
        "7DAY-ITEM",
        "28DAY-ITEM",
        "AV-ITEM",
        "BOOK",
        "CLE-ITEM",
        "DAYUSE-ITEM",
        "EBOOK",
        "ILL-ITEM",
        "OTHER",
        "RSV-ITEM",
        "SEM-ITEM",
        "SEMEXTEND-ITEM",
        "SERIAL"
      ]
    },
    {
      "name": "sub_type",
      "displayName": "Subtype",
      "type": "text",
      "required": false,
      "default": "All",
      "controlled.options": [
        "All",
        "AV Equipment",
        "Calculator",
        "Community User Station",
        "Hotspot",
        "Journal",
        "Laptop",
        "Magazine",
        "Newsletter",
        "Headphones",
        "Kit"
      ]
    },
    {
      "name": "campus",
      "displayName": "Campus",
      "type": "text",
      "required": false,
      "default": "All",
      "controlled.options": [
        "All",
        "Mid-Valley",
        "HSP",
        "Online",
        "Pecan",
        "RCPSE",
        "Starr County",
        "Technology"
      ]
    },
    {
      "name": "department",
      "displayName": "Department",
      "type": "text",
      "required": false,
      "default": "All",
      "controlled.options": ["All", "CLE", "Library", "Open Lab"]
    }
  ]
}
