{
    "displayName": "Library - Cataloger Activity Report 1",
    "description": "Displays FOLIO activity per cataloger for a given date range.",
    "instructions": "Input the date range and, optionally, select a system to run the report.",
    "parameters": [
        {
            "name": "start_date",
            "displayName": "Start Date",
            "type": "date",
            "required": true
        },
        {
            "name": "end_date",
            "displayName": "End Date",
            "type": "date",
            "required": false
        },
        {
            "name": "system",
            "displayName": "System Name",
            "type": "text",
            "required": true,
            "default": "All",
            "controlled.options": [
                "",
                "boomer",
                "helo",
                "apollo",
                "starbuck",
                "husker"
            ]
        }
    ]
}
